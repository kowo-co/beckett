# Beckett — the secrets inventory (issues #30 + #34). The real file lives at ~/.beckett/.env on
# the box (mode 0600, loaded by the daemon AND by systemd EnvironmentFile=) and is NEVER
# committed. This file is the authoritative key list: `beckett doctor` flags drift in BOTH
# directions (missing required key = fail; key in .env but not documented here = warn).
# A trailing `# optional` marks a key the daemon can run without.
#
# Encrypted backup: after ANY change to the real .env, run ./deploy/backup-secrets.sh from the
# Mac (age-encrypted to ~/.beckett-backups/; restore procedure in deploy/host-setup.md).

# ── required — the daemon refuses to be useful without these ─────────────────────────────────

# Discord bot token. Mint/rotate: discord.com/developers -> your app -> Bot -> Reset Token.
# Rotation = paste the new token here + `systemctl --user restart beckett-v4.service`.
DISCORD_TOKEN=
# The Discord APPLICATION id (not read by any code path — operator reference for building
# invite/authorize links to this bot without a trip to the dev portal).
DISCORD_APP_ID= # optional

# GitHub identity — the kowo-co GitHub App (#114). Beckett acts as `beckett[bot]` and mints a
# fresh 1-hour installation token per call; the old `0xbeckett` machine account is gone for good.
# Register it with `bun scripts/ops/github-app-register.ts` — full runbook in deploy/github-app.md.
#
# The numeric app id from https://github.com/organizations/kowo-co/settings/apps.
GITHUB_APP_ID=
# Path to the .pem downloaded when the app was created (mode 0600, NOT in the repo).
GITHUB_APP_PRIVATE_KEY_PATH=

# ── model APIs (additive tooling; not used by worker harness casts) ──────────────────────────

# OpenRouter API key — powers `beckett eval <author/model>` for provider-agnostic model evals.
# Mint: openrouter.ai → Keys. Optional: the daemon and ticket workers do not need it.
OPENROUTER_API_KEY= # optional
# HTTP-Referer sent with OpenRouter eval calls (this instance's public URL). Optional: defaults
# to empty. The installer seeds this key blank; set it if you attribute eval traffic.
OPENROUTER_REFERER= # optional

# ── ambient classifier (proactivity) ─────────────────────────────────────────────────────────

# Cerebras API key — powers the ambient burst classifier when config.toml sets
# `[proactivity] triage_provider = "cerebras"` (fast + cheap scoring vs spawning claude).
# Mint: cloud.cerebras.ai → API Keys. Optional: with triage_provider = "claude" it is unused.
CEREBRAS_API_KEY= # optional

# ── alerting (issue #30) ──────────────────────────────────────────────────────────────────────

# Raw Discord webhook for crash alerts + the weekly heartbeat — deliberately NOT the bot token,
# so alerts still fire when the daemon (the bot) is the thing that died. Mint: channel settings →
# Integrations → Webhooks on the ops channel.
DISCORD_ALERT_WEBHOOK_URL= # optional

# ── Discord identity plumbing ────────────────────────────────────────────────────────────────

# Discord user id for this instance's owner (required by install.sh; optional only when an
# access.txt allowlist is provisioned manually). The owner is access-list exempt.
DISCORD_OWNER_ID= # optional
DISCORD_OWNER_NAME= # optional
# Startup-banner / crash-loop-alarm channel. Set `disabled` to suppress these optional posts.
BECKETT_STARTUP_CHANNEL_ID= # optional
# Restart release-note ("what's new") channel. Set `disabled` to skip the announcement.
BECKETT_RELEASE_NOTE_CHANNEL_ID= # optional
# Channel where task/branch/subscription status cards land.
BECKETT_CARDS_CHANNEL_ID= # optional

# ── Cloudflare (DNS + tunnels + the 0xbeckett.me edge site) ──────────────────────────────────

# Mint: dash.cloudflare.com → My Profile → API Tokens. Permissions: Zone.DNS edit +
# Zone.Workers Routes edit on 0xbeckett.me, Account.Workers Scripts edit, Account.Cloudflare
# Tunnel read (the "upgraded" token per the domain memory).
CLOUDFLARE_API_TOKEN= # optional
CLOUDFLARE_ZONE_ID= # optional   (your Cloudflare zone id)
CLOUDFLARE_ACCOUNT_ID= # optional (wrangler deploys of web/)
CLOUDFLARE_TUNNEL_ID= # optional  (the named tunnel behind *.your-domain)

# ── mail: intake + outbox on your own domain (docs/mail.md) ──────────────────────────────────

# INTAKE. Shared secret the Cloudflare Email Worker (workers/mail-intake/) signs each delivery
# with, and the daemon verifies. Generate with `openssl rand -hex 32`, then set the SAME value as
# the Worker secret: `cd workers/mail-intake && wrangler secret put BECKETT_MAIL_INTAKE_SECRET`.
# The intake listener does not start at all while this is unset — that is the off switch.
BECKETT_MAIL_INTAKE_SECRET= # optional
# Loopback port the intake listener binds (the Cloudflare tunnel fronts it). Default 8788.
BECKETT_MAIL_INTAKE_PORT= # optional
# The address mail is delivered to. Default beckett@0xbeckett.me.
BECKETT_MAIL_INTAKE_ADDRESS= # optional

# OUTBOX. `beckett mail send` reads THIS key and nothing else; with it unset the command fails
# naming it, and every read verb (ls/read/mark-read) still works. Provider: Resend
# (https://resend.com) — see docs/mail.md for the SPF/DKIM/DMARC records it needs.
RESEND_API_KEY= # optional
# The address mail goes out as. Default beckett@0xbeckett.me.
BECKETT_MAIL_FROM= # optional

# ── ticket tracker (bored) ───────────────────────────────────────────────────────────────────

# Loopback URL of the bored tracker service (frgmt0/bored). The daemon, CLI, and doctor all
# read this; unset they use the managed-service default http://127.0.0.1:7770.
BECKETT_BORED_URL= # optional

# ── GitHub/identity extras ───────────────────────────────────────────────────────────────────

# The app's private key INLINE, as an alternative to GITHUB_APP_PRIVATE_KEY_PATH (literal `\n`
# escapes are accepted). Only one of the two is needed; the path form is preferred.
GITHUB_APP_PRIVATE_KEY_PEM= # optional
# The home installation (kowo-co). `beckett gh app installations` prints it. Optional: without it
# Beckett resolves the installation per target repo/owner, and uses the sole one if there is one.
GITHUB_APP_INSTALLATION_ID= # optional
# The app's slug, used to build the public install link https://github.com/apps/<slug>/…
# Optional: read live from `GET /app` when unset.
GITHUB_APP_SLUG= # optional

# Login Beckett's work is attributed to (defaults to config identity.github_user). When no
# BECKETT_GH_ORG is set, managed project repos are published under this account too.
GITHUB_ACCOUNT= # optional

# ── legacy fallback (third-party installs only) ──────────────────────────────────────────────

# A classic PAT, accepted ONLY as a fallback so a self-hosted fork without a GitHub App keeps
# working. On this instance it stays unset: the 0xbeckett account is gone and its token revoked.
# (GH_TOKEN / GITHUB_USER / GMAIL_* from earlier eras are dead — doctor warns if they linger.)
GITHUB_PAT= # optional

# ── agency extras (mail, image/video generation) ─────────────────────────────────────────────

# AgentMail API key — enables the mail capability commands AND the inbound mail listener
# (the poller stays off without it). Mint: agentmail.to → API Keys.
AGENTMAIL_API_KEY= # optional
# This instance's AgentMail address (the from/inbox for the mail capability). Optional: the mail
# commands report it unset until you provision one. The installer seeds this key blank.
BECKETT_MAIL_ADDRESS= # optional
# fal.ai key for image/video generation (the spelling FAL_API_KEY is also accepted).
# Mint: fal.ai → Keys. Without it, fal-backed generation is unavailable.
FAL_KEY= # optional
# Override the codex binary used by the image-generation harness (else auto-resolved).
BECKETT_CODEX_BIN= # optional
# BECKETT_BROWSER_* vars exist but are internal/advanced plumbing between the browser
# supervisor and its sandboxed host process — see src/browser/; not meant for the box .env.
# Two are operator-facing (see docs/browser-multi-lease.md): BECKETT_BROWSER_MAX_LEASES
# sets the concurrent-lease cap (default 3), and BECKETT_BROWSER_SINGLE_LEASE=1 is the
# kill switch that pins the browser back to strictly-single-lease behaviour.

# ── behavior overrides (defaults are right for the beckett box) ──────────────────────────────

BECKETT_DIR= # optional            (runtime dir; default ~/.beckett)
BECKETT_PROJECTS_ROOT= # optional  (project checkouts; default ~/Projects)
BECKETT_SELF_PROJECT= # optional   (the restricted self-repo slug; default "beckett")
# GitHub account/org that owns project repos. This takes precedence over GITHUB_ACCOUNT for repo
# ownership only; the PAT must still authenticate as GITHUB_ACCOUNT (or identity.github_user).
BECKETT_GH_ORG= # optional
BECKETT_GIT_NAME= # optional
BECKETT_GIT_EMAIL= # optional
BECKETT_LOG_LEVEL= # optional      (debug|info|warn|error)
