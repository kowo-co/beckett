# Beckett [DEV] staging env — copy to ~/.beckett-dev/.env and fill DISCORD_TOKEN. NEVER commit the
# real file. See docs/dev-instance.md for what to supply (a second bot application + token) and
# how deploy/dev/seed.sh --token-file/--owner-id (or $BECKETT_DEV_DISCORD_TOKEN/$DISCORD_OWNER_ID)
# writes this file for you, without ever printing the token.

# The dedicated Beckett [DEV] bot token. REQUIRED. (value intentionally blank in this template)
DISCORD_TOKEN=

# Owner's numeric Discord id. REQUIRED — the daemon stays in first-run "pending" mode (no Discord
# gateway) until DISCORD_TOKEN + DISCORD_OWNER_ID + GITHUB_PAT are all present.
DISCORD_OWNER_ID=

# Placeholder ONLY — DEV must not reach GitHub. A non-empty value clears the first-run gate; real
# GitHub calls fail by design (the identity resolver is satisfied by config.toml's github_user).
GITHUB_PAT=disabled-in-dev-staging

# Channel isolation lives in the UNIT (deploy/systemd/beckett-dev.service), not here:
#   BECKETT_STARTUP_CHANNEL_ID=disabled       -> no boot banner / crash alarm into prod channels
#   BECKETT_CARDS_CHANNEL_ID=disabled         -> no status dashboard / cards into prod channels
#
# Deliberately OMITTED so the matching capability/side effect is unavailable in DEV:
#   CLOUDFLARE_API_TOKEN / CLOUDFLARE_ZONE_ID / CLOUDFLARE_TUNNEL_ID  -> `beckett deploy` / `dns` off
#   DISCORD_ALERT_WEBHOOK_URL                                         -> crash-alert webhook off
#   DISCORD_LOG_CHANNEL_ID                                            -> log-mirror channel off
#   BECKETT_ROUTINE_CHANNEL_ID                                        -> no routine origin/narration
#   AGENTMAIL_API_KEY / FAL_KEY / OPENROUTER_* / CEREBRAS_API_KEY     -> mail/image/triage extras off
