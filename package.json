{
  "name": "beckett",
  "version": "7.2.3",
  "description": "Beckett — an agentic coworker reached in Discord. A harness over harnesses.",
  "type": "module",
  "private": true,
  "module": "src/shell/main.ts",
  "scripts": {
    "v4": "bun src/shell/main.ts",
    "beckett": "bun src/cli/beckett.ts",
    "test": "bun test --path-ignore-patterns src/browser/runtime.test.ts --path-ignore-patterns src/browser/isolated.test.ts --path-ignore-patterns src/browser/agent.test.ts --path-ignore-patterns src/browser/isolated.sandboxed.test.ts",
    "test:browser": "bun test ./src/browser/runtime.test.ts ./src/browser/isolated.test.ts ./src/browser/agent.test.ts",
    "test:browser:sandboxed": "bun test ./src/browser/isolated.sandboxed.test.ts",
    "test:all": "bun test",
    "browser:smoke": "bun scripts/ops/browser-smoke.ts",
    "shot": "bun scripts/shot.ts",
    "browser:bench": "bun scripts/bench/browser-lane.ts",
    "eval:browser": "bun scripts/eval/browser-agent.ts",
    "eval:triage": "bun scripts/eval/triage-classifier.ts",
    "eval:turns": "bun scripts/eval/turn-decisions.ts",
    "eval:turns:regression": "bun scripts/eval/turn-decisions-regression-demo.ts",
    "telemetry:refresh": "bun scripts/ops/telemetry-harvest.ts",
    "code-stats:refresh": "bun scripts/ops/code-stats-harvest.ts",
    "dead-exports": "bun scripts/ops/dead-exports.ts",
    "moss:smoke": "bun test src/moss-local/index.test.ts",
    "voice:loopback": "bun scripts/voice/loopback.ts",
    "bench:startup": "bun scripts/bench/startup.ts",
    "moss:bench": "bun scripts/bench/moss-local.ts",
    "memory:bench": "bun scripts/bench/recall-memory.ts",
    "recall:bench": "bun scripts/bench/recall-relevance.ts",
    "recall:agent-bench": "bun scripts/bench/recall-agent.ts",
    "typecheck": "bun x tsc --noEmit"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@modelcontextprotocol/sdk": "^1.13.0",
    "@moss-dev/moss-core": "0.8.7",
    "agentmail": "^0.5.17",
    "betterwright": "1.7.2",
    "discord.js": "^14.27.0",
    "libsodium-wrappers": "^0.8.4",
    "opusscript": "^0.1.1",
    "playwright": "^1.62.0",
    "prism-media": "^1.3.5",
    "smol-toml": "^1.7.0",
    "zod": "^3.25.76"
  },
  "overrides": {
    "undici": "6.27.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "bun-types": "^1.3.14",
    "typescript": "^5.9.3"
  }
}
