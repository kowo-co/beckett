# dependencies
node_modules

# build output
dist/

# SQLite (state lives in ~/.beckett, never in-repo — but ignore stray copies)
*.db
*.db-wal
*.db-shm

# secrets
.env
# GitHub App private keys (#114) — these live in ~/.beckett/, never in the repo, but a stray
# download into the checkout must never be committable.
*.pem
*.private-key.pem

# Beckett runtime home (if BECKETT_DIR points into the repo during local testing)
/home
.beckett/

# scratch / temp
scratch/
output/
*.log
.agents/
.gstack/
.tmp/
.tmp-*.mjs

# bench artifacts
.bench-out/

# npm lockfile — this project standardizes on bun.lock
package-lock.json

# review scratch / personal notes
.review/
.review-tmp/
.review-scratch/
my-docs/
report-fable.md
proposal.md
.claude/worktrees/
.shots/
screenshots/

# task-141 verification scratch (never a deliverable)
.scratch/

